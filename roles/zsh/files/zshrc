zmodload zsh/zprof

if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH
fi

autoload -Uz compinit
if [ $(date +'%j') != $(stat -f '%Sm' -t '%j' ~/.zcompdump) ]; then
  compinit
else
  compinit -C
fi

setopt autocd

bindkey -e
bindkey "^[[3~" delete-char

command -v starship >/dev/null && eval "$(starship init zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# . "$HOME/.starkli/env"
# . $HOME/.starknet_env

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

[ -x "$HOME/.local/bin/mise" ] && eval "$($HOME/.local/bin/mise activate zsh)"

autoload -U +X bashcompinit && bashcompinit
[ -x /opt/homebrew/bin/terraform ] && complete -o nospace -C /opt/homebrew/bin/terraform terraform

precmd() { echo -ne "\033]0;$(basename "$PWD")\007" }

# stellar completions
# source <(stellar completion --shell zsh)

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

export PATH="$HOME/.bun/bin:$PATH"


# Pi
export PATH="$HOME/.local/share/mise/installs/node/24.5.0/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
